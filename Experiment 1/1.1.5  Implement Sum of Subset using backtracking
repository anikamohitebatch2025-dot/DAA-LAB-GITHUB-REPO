#include <stdio.h>

#define MAX_N 20
#define MAX_SOLUTIONS 10000

int n, target;
int arr[MAX_N];

int solutions[MAX_SOLUTIONS][MAX_N];
int solution_lengths[MAX_SOLUTIONS];
int sol_count = 0;

void find(int idx, int current_sum, int *current_subset, int current_len) {
    if (current_sum > target)
        return;

    if (idx == n) {
        if (current_sum == target) {
            for (int i = 0; i < current_len; i++) {
                solutions[sol_count][i] = current_subset[i];
            }
            solution_lengths[sol_count] = current_len;
            sol_count++;
        }
        return;
    }

    current_subset[current_len] = arr[idx];
    find(idx + 1, current_sum + arr[idx], current_subset, current_len + 1);

    find(idx + 1, current_sum, current_subset, current_len);
}

int main() {
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &target);

    int current[MAX_N];

    find(0, 0, current, 0);

    if (sol_count == 0) {
        printf("-1");
    } else {
        for (int i = sol_count - 1; i >= 0; i--) {
            for (int j = 0; j < solution_lengths[i]; j++) {
                printf("%d ", solutions[i][j]);
            }
            printf("\n");
        }
    }

    return 0;
}
