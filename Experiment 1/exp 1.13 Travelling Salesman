#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define MAX_CITIES 20

int n;
int cost[MAX_CITIES][MAX_CITIES];
int visited[MAX_CITIES];
int min_total_cost = INT_MAX;

// Recursive function to find TSP path
// current_city: the city we are currently at
// count: number of cities visited so far
// current_cost: cost accumulated so far
void tsp(int current_city, int count, int current_cost) {
    // Base case: If all cities are visited
    if (count == n) {
        // Check if we can return to the starting city (0)
        if (cost[current_city][0] != -1) {
            int total = current_cost + cost[current_city][0];
            if (total < min_total_cost) {
                min_total_cost = total;
            }
        }
        return;
    }

    // Try to visit all other unvisited cities
    for (int next_city = 0; next_city < n; next_city++) {
        // Check if the city is not visited and there is a path
        if (!visited[next_city] && cost[current_city][next_city] != -1) {
            // Pruning: if current cost already exceeds best found, skip
            // (Optional, but good for performance)
            // Note: We can't easily prune strictly without a heuristic, 
            // but we can check against min_total_cost if we had a lower bound.
            // For simple backtracking, we just proceed.
            
            visited[next_city] = 1;
            tsp(next_city, count + 1, current_cost + cost[current_city][next_city]);
            visited[next_city] = 0; // Backtrack
        }
    }
}

int main() {
    // Read number of cities
    if (scanf("%d", &n) != 1) return 0;

    // Read the cost matrix
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    // Initialize visited array
    for (int i = 0; i < n; i++) {
        visited[i] = 0;
    }

    // Start from city 0
    visited[0] = 1;
    
    // Edge case: if n=1, cost is 0 (or undefined depending on problem, usually 0)
    if (n == 1) {
        printf("0");
        return 0;
    }

    // Start the recursion
    tsp(0, 1, 0);

    // Output the result
    if (min_total_cost == INT_MAX) {
        // This case implies no valid tour exists
        // Depending on problem requirements, might need to output -1 or similar
        // Assuming a valid tour always exists based on typical TSP problems
        printf("-1"); 
    } else {
        printf("%d", min_total_cost);
    }

    return 0;
}
